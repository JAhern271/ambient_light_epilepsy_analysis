# Ignore the data folder at the repository root only.
# A bare "data/" would also match tests/data/, which holds committed fixtures.
/data/
*.edf
*.set
*.fdt
*.bdf

# Ignore Jupyter auto-generated files
.ipynb_checkpoints/

# Environments
.env
.venv/
venv/

# Machine-specific path overrides (config.toml IS committed)
config.local.toml

# Ignore system files
.DS_Store
Thumbs.db

# Ignore temporary files
*.tmp
*.log
*.bak

# Slurm job logs, written next to the submission scripts on the HPC
*.out
*.err
*.stats

__pycache__/
*.pyc
.pytest_cache/

# Data (do NOT version raw NHANES data)
/data/raw/
/data/processed/
/data/interim/